    "start": "node server/start.js",
    "check": "node --check server/index.js && node --check server/start.js && node --check server/app.js && node --check server/routes.js && node --check server/models.js && node --check server/auth.js && node --check server/clerkProxyMiddleware.js"
  },
  "dependencies": {
    "@clerk/express": "^2.1.70",
    "@clerk/react": "^6.17.0",
    "@clerk/shared": "^4.34.0",
    "@clerk/themes": "^2.4.57",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.545.0",
    "mongoose": "^9.10.2",
    "pino": "^9.14.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
