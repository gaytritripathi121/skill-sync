# Copy this file to .env and replace every placeholder locally.
# Never commit .env or paste these values into chat.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Use development keys from your Clerk instance for local development.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=

# The local Vite app runs on port 5173 and the Express API on port 5000.
VITE_API_BASE_URL=http://localhost:5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173